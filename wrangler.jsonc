{
  // Cloudflare Workers static-assets config for the Fineliner PWA (spec M15).
  // The PWA is a pure client-side bundle: Workers just serves ./ui/dist with a
  // single-page-application fallback so deep links resolve to index.html.
  //
  // Deploy runs through Cloudflare's Workers Builds Git integration. The root
  // package.json "build" script runs scripts/cf-build.sh (installs the
  // Rust/wasm-pack toolchain the build image lacks and produces ./ui/dist), so
  // the default build command (`bun run build` / `npm run build`) works with no
  // dashboard change; the default deploy command `npx wrangler deploy` uses
  // this config.
  //
  // Branch control — which branches deploy to production — is NOT expressible
  // in this file. It belongs to the Workers Builds Git-integration
  // configuration in the Cloudflare dashboard, alongside the build/deploy
  // commands and root directory; wrangler config describes the Worker and its
  // assets, not which branches the Git integration treats as production. See
  // STATUS.md ("Release automation + Cloudflare deploy") — restricting
  // production deploys to `main` is an open human action item there.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amigo-fineliner",
  "compatibility_date": "2026-07-10",
  "assets": {
    "directory": "./ui/dist",
    "not_found_handling": "single-page-application"
  }
}
