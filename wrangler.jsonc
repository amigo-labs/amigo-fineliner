{
  // Cloudflare Workers static-assets config for the Fineliner PWA (spec M15).
  // The PWA is a pure client-side bundle: Workers just serves ./ui/dist with a
  // single-page-application fallback so deep links resolve to index.html.
  //
  // Deploy is driven by GitHub Actions (.github/workflows/release.yml), which
  // builds the bundle with the full Rust + wasm-pack toolchain and then runs
  // `wrangler deploy`. The bundle needs Rust/wasm-pack to compile the WASM,
  // which Cloudflare's Git-integration build image does not provide — so build
  // in CI, deploy the artifact here.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amigo-fineliner",
  "compatibility_date": "2026-07-10",
  "assets": {
    "directory": "./ui/dist",
    "not_found_handling": "single-page-application"
  }
}
